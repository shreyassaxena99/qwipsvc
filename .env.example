# Stripe
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (service-role key required for reservation RPCs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Email and walk-up sessions
RESEND_API_KEY=re_...
JWT_SECRET_KEY=your-random-jwt-secret
SEAM_API_KEY=your-seam-api-key
USE_STATIC_CODES=true
STATIC_CODE_B64_KEY=your-base64url-aes-key

# Reservation server-to-server endpoints
RESERVATION_WORKER_TOKEN=your-random-worker-token
RESERVATION_LOVABLE_TOKEN=your-random-lovable-token
RESERVATION_ADMIN_TOKEN=your-random-admin-token

# Optional reservation content and scheduling rules
RESERVATION_BLOCKED_DATES=
RESERVATION_DIRECTIONS=Westfield London
RESERVATION_MAPS_URL=https://maps.google.com/?q=Westfield+London
RESERVATION_SUPPORT_URL=https://qwip.co.uk/support
LOG_LEVEL=INFO
